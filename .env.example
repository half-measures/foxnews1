# Copy to .env (next to docker-compose.yml). Compose reads it automatically.
# .env is gitignored: it is the right place for passwords.

# Local time for the daily schedule. UTC if unset.
TZ=America/New_York

# Postgres started by this compose file.
POSTGRES_USER=foxcomments
POSTGRES_PASSWORD=change-me
POSTGRES_DB=foxcomments
# Host port for it. Change this if something else on the host already uses 5432;
# the scraper reaches Postgres at db:5432 over the compose network regardless.
POSTGRES_PORT=5432

# Using a database elsewhere instead? Point this at it and skip the db service:
#   docker compose up -d scraper
# DATABASE_URL=postgresql://user:password@dbhost:5432/foxcomments?sslmode=require

# Metabase (analytics UI at http://<host>:METABASE_PORT). Change the port if 3000 is taken.
METABASE_PORT=3000
# Password for the read-only Postgres login Metabase uses to query the data.
# You type it once into Metabase's "Add a database" form.
METABASE_READER_PASSWORD=change-me-too
